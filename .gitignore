# Tuist Generated Files
# All .xcodeproj files are generated by Tuist from Project.swift manifests
*.xcodeproj

# Tuist generated workspace
# The workspace is generated from Workspace.swift
*.xcworkspace

# Tuist generated derived files
# Contains generated Info.plist files
Derived/

# Tuist dependencies and build artifacts
Tuist/.build/
Tuist/.swiftpm/
Tuist/Package.resolved

# Xcode User Data
# User-specific settings and state
xcuserdata/

# Xcode Build Products
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Xcode Legacy
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.hmap
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# IDE Configuration
.vscode/
.idea/
.fleet/

# Environment & Secrets
.env
.env.local
.env.*.local

# Temporary Files
*.swp
*.bak
*.tmp
*~.nib
